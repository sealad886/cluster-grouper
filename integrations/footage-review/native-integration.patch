+        let operation = begin()
+        defer { finish(operation) }
+        do {
+            guard !store.isLoadingLibrary, !store.isImporting, !store.isScanning else {
+                throw ClusteringFailure("Wait for the library to finish loading or scanning before resuming.")
+            }
