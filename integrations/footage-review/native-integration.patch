+            if let activeJob, let client, activeJob.isActive {
+                let cancelled = try await client.control(activeJob.id, action: "cancel")
+                generation = UUID()
+                publish(cancelled)
+                run?.stage = "cancelled"
+                try persistRun()
+            } else {
+                generation = UUID()
+                await backend.stop()
