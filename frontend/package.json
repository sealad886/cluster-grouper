{
  "name": "cluster-grouper-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test",
    "generate:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o lib/generated-api.d.ts",
    "test:lint": "node --test tests/lint.test.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "oxlint": "1.92.0"
  }
}
